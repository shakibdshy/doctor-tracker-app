# Copy to .env and fill in. Never commit the real .env.
NODE_ENV=development

# 32+ characters; generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32-plus-character-secret

# Public origin of this Express server (used by better-auth)
BETTER_AUTH_URL=http://localhost:3000

# Web app origin allowed by CORS / trusted origins
CORS_ORIGIN=http://localhost:3001

# MongoDB connection string — local mongod or an Atlas cluster
DATABASE_URL=mongodb://127.0.0.1:27017/doctor-tracker

# Optional; defaults to 3000
PORT=3000